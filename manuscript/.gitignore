# Correspondence with the reviewers and the editor. Kept here so that
# assemble.py can build the reply letters, but never committed while the
# article is under review. See README.md.
response_to_reviewers.md
response_resolved.md
response_reviewer_*.md
response2_reviewer_*.md
letter_openings.md
editor_replies.md
cover_letter*.md

# Build artefacts of assemble.py.
# Note: git has no inline comments in .gitignore, so these stay on their own lines.
# figs/ is copied from ../results/figures at build time.
figs/
# author_notes.md is the regenerated list of items left for the authors.
author_notes.md
__pycache__/
*.bak

# Built documents, when ZSH_DOCX_OUT points at the repository root.
/ZSH_FinTech_MDPI_manuscript_v2*.docx
/ZSH_supplementary_v2*.docx
